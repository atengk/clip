# ==============================================================================
# Git 跨平台换行符自动归一化配置
# 强制所有文本文件统一使用 LF 换行符，杜绝 Windows CRLF 导致 Linux 脚本崩溃
# ==============================================================================

# 默认自动检测文本并统一换行为 LF
* text=auto eol=lf

# 纯文本与配置文件强制 LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.css text eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件声明
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.tar.gz binary
*.exe binary
*.msi binary
*.dll binary
*.clipbak binary
